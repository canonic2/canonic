{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonic Studio project",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "ide": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "settings": { "type": "object" } }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/definitions/command" },
        "provision": { "$ref": "#/definitions/command" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(PORT|[A-Z][A-Z0-9_]*_PORT)$" }
        },
        "previewPort": { "type": "string" },
        "readyPath": { "type": "string", "pattern": "^/(?!/)", "default": "/health" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 },
        "provisionTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "default": 180000
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "waitTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 60 }
          }
        }
      }
    }
  },
  "definitions": {
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
