---
/* The Changelog page: every published workbench release, newest first, with
   its notes from GitHub, its links, and whichever builds it has. */
import Base from '../../layouts/Base.astro';
import { download, downloads as loadDownloads, github, releases as loadReleases, workbenchNav } from '../../lib/workbench.js';

const downloads = await loadDownloads();
const releases = await loadReleases();
// The Install sections link one release; it is the one marked Latest.
const latest = downloads && downloads.version || releases && releases[0] && releases[0].version;
const day = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const arrow = 'M8 2.5v8 M4.5 7L8 10.5 11.5 7 M3 13.5h10';
---
<Base
  title="Changelog · Canonic Workbench"
  description="Every release of Canonic Workbench, newest first, with its notes, its changes on GitHub, and its builds where available."
  product="Workbench"
  version={latest}
  nav={workbenchNav('Changelog')}
  github={github}
  download={download}
>
  <section class="page-hero">
    <div class="wrap narrower">
      <span class="kicker">Changelog</span>
      <h1>What’s new in Workbench</h1>
      <p class="lede">Every release of Canonic Workbench, newest first, with its full list of changes on GitHub. Builds are listed for the releases that have them.</p>
    </div>
  </section>

  <section class="releases-section" aria-label="Releases">
    <div class="wrap narrower">
      {releases && releases.length ? (
        <ol class="releases">
          {releases.map(release => (
            <li class="release" id={`v${release.version}`}>
              <div class="release-meta">
                <span class="release-version">
                  <a href={`#v${release.version}`}>v{release.version}</a>
                  {release.version === latest && <span class="badge">Latest</span>}
                </span>
                {release.published && <time datetime={release.published.slice(0, 10)}>{day.format(new Date(release.published))}</time>}
                <span class="release-tag">{release.tag}</span>
              </div>
              <div class="release-body">
                {release.notes.length > 0 && (
                  <div class="release-notes">
                    {release.notes.map(block => block.items
                      ? <ul>{block.items.map(item => <li>{item}</li>)}</ul>
                      : <p>{block.text}</p>)}
                  </div>
                )}
                <div class="actions-row">
                  <a class="btn btn-sm" href={release.changes} target="_blank" rel="noopener">Full changelog on GitHub</a>
                  <a class="btn btn-sm btn-ghost" href={release.url} target="_blank" rel="noopener">Release page</a>
                </div>
                {release.files.length > 0 && (
                  <div class="builds">
                    <span class="builds-head">Builds</span>
                    <div class="builds-list">
                      {release.files.map(file => (
                        <a class="get" href={file.url} aria-label={`Download v${release.version} for ${file.computer}: ${file.name}`}>
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} /></svg>
                          {file.short}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : releases ? (
        <p class="lede">The first Workbench release will appear here.</p>
      ) : (
        <p class="lede">The release list couldn’t be loaded. See <a href={`${github}/releases`} target="_blank" rel="noopener">Workbench releases on GitHub</a>.</p>
      )}
    </div>
  </section>
</Base>
