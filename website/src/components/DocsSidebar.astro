---
/* The docs sidebar: every guide by group, with the current one marked. It
   stays open on wide screens and collapses on narrow ones. Search filters the
   list from the docs' search index; without JavaScript it is hidden and the
   list is complete. */
import { base } from '../lib/base.js';
import { docTitle, docsHref } from '../lib/docs.js';
import { pages } from '../lib/workbench.js';

interface Props {
  groups: { title: string; entries: { id: string; body: string }[] }[];
  /** The guide being shown. */
  current: string;
}
const { groups, current } = Astro.props;
---
<canonic-docs-sidebar>
  <details class="docs-sidebar" open>
    <summary>Documentation <span aria-hidden="true">⌄</span></summary>
    <div class="docs-sidebar-body">
      <div class="docs-search" hidden>
        <label for="docs-search">Search the docs</label>
        <input id="docs-search" type="search" placeholder="Search the docs" autocomplete="off" aria-controls="docs-navigation" data-index={`${base}workbench/docs/search.json`} />
        <p class="docs-search-status" role="status"></p>
      </div>
      <nav id="docs-navigation" aria-label="Documentation">
        {groups.map(group => <div class="docs-group">
          <h2>{group.title}</h2>
          {group.entries.map(page => <a href={docsHref(page.id, base)} data-doc-id={page.id}
            aria-current={page.id === current ? 'page' : undefined}>{docTitle(page)}</a>)}
        </div>)}
      </nav>
      <a class="docs-install" href={pages.install}>Get Workbench <span aria-hidden="true">→</span></a>
    </div>
  </details>
</canonic-docs-sidebar>

<script>
  class CanonicDocsSidebar extends HTMLElement {
    connectedCallback() {
      const sidebar = this.querySelector<HTMLDetailsElement>('.docs-sidebar');
      const mobile = matchMedia('(max-width: 820px)');
      if (sidebar) {
        sidebar.open = !mobile.matches;
        mobile.addEventListener('change', () => { sidebar.open = !mobile.matches; });
      }
      const search = this.querySelector<HTMLInputElement>('input[type=search]');
      const status = this.querySelector<HTMLElement>('.docs-search-status');
      if (!search || !status) return;
      search.closest<HTMLElement>('.docs-search')!.hidden = false;
      const links = [...this.querySelectorAll<HTMLAnchorElement>('[data-doc-id]')];
      const groups = [...this.querySelectorAll<HTMLElement>('.docs-group')];
      let index: Promise<{ id: string; text: string }[]> | undefined;
      let generation = 0;
      search.addEventListener('input', async () => {
        const current = ++generation;
        const query = search.value.trim().toLowerCase();
        if (!query) {
          links.forEach(link => { link.hidden = false; });
          groups.forEach(group => { group.hidden = false; });
          status.textContent = '';
          return;
        }
        try {
          index ||= fetch(search.dataset.index || '').then(response => {
            if (!response.ok) throw new Error('Search unavailable');
            return response.json();
          }).catch(error => { index = undefined; throw error; });
          const entries = await index;
          if (current !== generation) return;
          const words = query.split(/\s+/);
          const matches = new Set(entries.filter(entry => words.every(word => entry.text.includes(word))).map(entry => entry.id));
          links.forEach(link => { link.hidden = !matches.has(link.dataset.docId || ''); });
          groups.forEach(group => { group.hidden = !group.querySelector('a:not([hidden])'); });
          status.textContent = matches.size ? `${matches.size} matching guides` : 'No matching guides';
        } catch {
          if (current === generation) status.textContent = 'Search unavailable. Browse the guides below.';
        }
      });
    }
  }
  if (!customElements.get('canonic-docs-sidebar')) customElements.define('canonic-docs-sidebar', CanonicDocsSidebar);
</script>
