---
/* Progressive enhancement for the pages that offer downloads. Without it,
   every download is still listed. Elements opt in with data attributes:
   - data-target, data-file, data-short, data-href: one download (a card or a
     table row); data-rec-badge inside it is shown on the recommended one.
   - data-install-cmd: an install command that names the recommended file.
   - #heroDownload: a button renamed for this computer.
   - #recommended: a panel filled in with the recommended download, with
     data-rec-name, data-rec-file, data-rec-link, and data-rec-alt inside.
   Copy buttons (.copy) copy the code beside them. */
---
<script is:inline>
/* Recommend the download for this computer. Macs get the Apple silicon
   build; the browser can't tell Intel apart reliably, so the panel offers
   the other build of the same system too. */
(function () {
  var platform = '';
  try {
    platform = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '').toLowerCase();
  } catch (e) { return; }
  var os = platform.indexOf('mac') >= 0 ? 'mac' : platform.indexOf('win') >= 0 ? 'win' : (platform.indexOf('linux') >= 0 || platform.indexOf('x11') >= 0) ? 'linux' : null;
  if (!os) return;
  var pick = {
    mac: { target: 'darwin-arm64', alt: 'darwin-x64', ask: 'On a Mac with Intel?', name: 'Mac' },
    win: { target: 'win32-x64', alt: 'win32-arm64', ask: 'On Windows on Arm?', name: 'Windows' },
    linux: { target: 'linux-x64', alt: 'linux-arm64', ask: 'On Linux on Arm?', name: 'Linux' },
  }[os];
  var hero = document.getElementById('heroDownload');
  if (hero) hero.textContent = 'Download for ' + pick.name;
  var matches = document.querySelectorAll('[data-target="' + pick.target + '"]');
  if (!matches.length) return;
  matches.forEach(function (item) {
    item.classList.add('is-recommended');
    var badge = item.querySelector('[data-rec-badge]');
    if (badge) badge.hidden = false;
    var link = item.matches('a') ? item : item.querySelector('a[aria-label]');
    if (link) link.setAttribute('aria-label', link.getAttribute('aria-label') + ', recommended for this computer');
  });
  var chosen = matches[0];
  var file = chosen.getAttribute('data-file');
  document.querySelectorAll('[data-install-cmd]').forEach(function (cmd) {
    cmd.textContent = 'code --install-extension ' + file;
  });
  var panel = document.getElementById('recommended');
  if (!panel) return;
  panel.querySelector('[data-rec-name]').textContent = chosen.getAttribute('data-short');
  panel.querySelector('[data-rec-file]').textContent = file;
  var get = panel.querySelector('[data-rec-link]');
  get.href = chosen.getAttribute('data-href');
  get.setAttribute('aria-label', 'Download ' + file);
  var other = document.querySelector('[data-target="' + pick.alt + '"]');
  var alt = panel.querySelector('[data-rec-alt]');
  if (other && alt) {
    alt.querySelector('[data-rec-alt-ask]').textContent = pick.ask;
    var altLink = alt.querySelector('a');
    altLink.href = other.getAttribute('data-href');
    altLink.textContent = 'Download ' + other.getAttribute('data-file');
    alt.hidden = false;
  }
  panel.hidden = false;
})();

/* Copy buttons copy the code beside them. */
(function () {
  document.addEventListener('click', function (e) {
    var button = e.target.closest && e.target.closest('.copy');
    if (!button) return;
    var box = button.closest('.code, .cmd');
    var code = box && box.querySelector('code');
    if (!code || !navigator.clipboard) return;
    navigator.clipboard.writeText(code.textContent).then(function () {
      button.textContent = 'Copied';
      clearTimeout(button.copyTimer);
      button.copyTimer = setTimeout(function () { button.textContent = 'Copy'; }, 1600);
    }, function () {});
  });
})();
</script>
