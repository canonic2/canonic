---
/* A section head with a lede in its slot, as the overview uses it. */
import SectionHead from '../../src/components/SectionHead.astro';
const { kicker, title, lede } = Astro.props;
---
<div class="wrap">
  {lede
    ? <SectionHead kicker={kicker} title={title}>Workbench reads <code>workbench.yaml</code> at the root of your project.</SectionHead>
    : <SectionHead kicker={kicker} title={title} />}
</div>
