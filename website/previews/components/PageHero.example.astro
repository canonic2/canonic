---
/* A page hero with a lede in its slot, as the Install page uses it. */
import PageHero from '../../src/components/PageHero.astro';
const { kicker, title, width } = Astro.props;
---
<PageHero kicker={kicker} title={title} width={width}>
  In VS Code, search for <b>Canonic Workbench</b> in the Extensions view. Then add a <code>workbench.yaml</code> to your project.
</PageHero>
