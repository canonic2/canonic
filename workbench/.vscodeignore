# What stays out of the .vsix. Everything not listed here ships — which now
# includes workbench/, the tool itself, because a project no longer keeps a
# copy of it.
.vscode/**
.gitignore
**/*.test.js
**/.DS_Store
icon-source.svg
scripts/**
dist/**
capture-helper/**
# Never ship a leftover bundle from before the shared runtime was renamed.
capture-runtime/**
window-capture/simulator-demo/**
docs/**
specs/**
design/**
workbench/README.md
preview/README.md
preview/LICENSE
node_modules/**/README.md
node_modules/**/*.map
node_modules/**/*.d.ts
node_modules/**/dist/esm/**
node_modules/lucide/**
!node_modules/lucide/package.json
!node_modules/lucide/LICENSE
!node_modules/lucide/dist/umd/lucide.min.js
