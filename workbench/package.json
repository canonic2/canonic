{
  "name": "canonic-workbench",
  "displayName": "Canonic Workbench",
  "description": "Renders a project's pages and component previews on one canvas at device widths, with annotations and screenshots for coding agents.",
  "version": "0.12.0",
  "publisher": "canonic",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://canonic.sh/workbench/",
  "repository": {
    "type": "git",
    "url": "https://github.com/canonic2/canonic.git"
  },
  "bugs": {
    "url": "https://github.com/canonic2/canonic/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.123.0",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "design",
    "design system",
    "preview",
    "screenshot",
    "storybook",
    "implementation",
    "lens"
  ],
  "activationEvents": [
    "workspaceContains:workbench.yaml",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "node --test",
    "check": "tsc -p tsconfig.json",
    "serve": "node server.js",
    "package": "node scripts/package.cjs",
    "package:all": "node scripts/package-all.cjs",
    "bundle-runtime": "node scripts/bundle-runtime.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@vscode/vsce": "3.9.2",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.3",
    "typescript": "7.0.2",
    "vue": "3.5.43"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canonic",
          "title": "Workbench",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "canonic": [
        {
          "type": "webview",
          "id": "canonic.sidebar",
          "name": "Workbench",
          "when": "canonic.hasWorkbench"
        }
      ]
    },
    "commands": [
      {
        "command": "canonic.openWorkbench",
        "title": "Open Canvas",
        "category": "Workbench",
        "icon": "$(open-preview)"
      },
      {
        "command": "canonic.openWorkbenchExternally",
        "title": "Open Canvas in Browser",
        "category": "Workbench"
      },
      {
        "command": "canonic.copyWorkbenchUrl",
        "title": "Copy Canvas URL",
        "category": "Workbench"
      },
      {
        "command": "canonic.refreshPages",
        "title": "Refresh Pages",
        "category": "Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "canonic.showWorkbenchLog",
        "title": "Show Log",
        "category": "Workbench"
      },
      {
        "command": "canonic.addSpace",
        "title": "Add Space…",
        "category": "Workbench"
      },
      {
        "command": "canonic.switchSpace",
        "title": "Switch Space…",
        "category": "Workbench"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canonic.switchSpace",
          "when": "canonic.hasWorkbench"
        },
        {
          "command": "canonic.refreshPages",
          "when": "canonic.hasWorkbench"
        }
      ],
      "view/title": [
        {
          "command": "canonic.openWorkbench",
          "when": "view == canonic.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "canonic.refreshPages",
          "when": "view == canonic.sidebar",
          "group": "navigation@2"
        }
      ]
    }
  },
  "dependencies": {
    "@vue/compiler-sfc": "3.5.43",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "lucide": "1.33.0",
    "marked": "18.0.14",
    "picomatch": "4.0.7",
    "tar": "7.5.22"
  }
}
