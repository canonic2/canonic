{
  "name": "canonic-workbench",
  "displayName": "Workbench",
  "description": "A design workbench for the screens in your repo: every page and preview on one canvas, marked up and handed to your agent.",
  "version": "0.8.0",
  "publisher": "canonic",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.75.0", "node": ">=18" },
  "categories": ["Visualization", "Other"],
  "keywords": ["design", "design system", "preview", "screenshot", "storybook", "implementation", "lens"],
  "activationEvents": ["workspaceContains:workbench.yaml"],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "serve": "node server.js",
    "package": "node scripts/package.cjs",
    "package:all": "node scripts/package-all.cjs",
    "bundle-runtime": "node scripts/bundle-runtime.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "19.3.0",
    "@vscode/vsce": "3.9.2",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.3",
    "typescript": "7.0.2",
    "vue": "3.5.43"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canonic",
          "title": "Workbench",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "canonic": [
        {
          "type": "webview",
          "id": "canonic.screens",
          "name": "Workbench",
          "when": "canonic.hasWorkbench"
        }
      ]
    },
    "commands": [
      {
        "command": "canonic.openWorkbench",
        "title": "Open Canvas",
        "category": "Workbench",
        "icon": "$(open-preview)"
      },
      {
        "command": "canonic.openWorkbenchExternally",
        "title": "Open Canvas in Browser",
        "category": "Workbench"
      },
      {
        "command": "canonic.copyWorkbenchUrl",
        "title": "Copy Canvas URL",
        "category": "Workbench"
      },
      {
        "command": "canonic.refreshScreens",
        "title": "Refresh Screens",
        "category": "Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "canonic.showWorkbenchLog",
        "title": "Show Log",
        "category": "Workbench"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canonic.refreshScreens",
          "when": "canonic.hasWorkbench"
        }
      ],
      "view/title": [
        {
          "command": "canonic.openWorkbench",
          "when": "view == canonic.screens",
          "group": "navigation@1"
        },
        {
          "command": "canonic.refreshScreens",
          "when": "view == canonic.screens",
          "group": "navigation@2"
        }
      ]
    }
  },
  "dependencies": {
    "@vue/compiler-sfc": "3.5.43",
    "esbuild-wasm": "0.28.2",
    "lucide": "1.33.0",
    "picomatch": "4.0.7",
    "tar": "7.5.22"
  }
}
