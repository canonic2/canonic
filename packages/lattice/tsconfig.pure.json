{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.js",
    "src/modules/store/**/*.js",
    "src/testing/**/*.js",
    "types/shared-platform.d.ts"
  ],
  "exclude": ["**/*.test.js", "**/*.browser.test.js", "**/*.bench.js"]
}
