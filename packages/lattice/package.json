{
  "name": "@canonic2/lattice",
  "version": "0.0.0",
  "private": true,
  "description": "Native JavaScript primitives for state and Web Component bindings.",
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.bench.js",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./collection": "./src/modules/collection/collection.js",
    "./experimental/collection": "./src/modules/collection/experimental.js",
    "./elements": "./src/modules/elements/elements.js",
    "./testing": "./src/testing/index.js"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --project tsconfig.pure.json && tsc --project tsconfig.dom.json && tsc --project tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:watch": "vitest --project browser",
    "browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.5",
    "eslint-plugin-jsdoc": "65.4.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
