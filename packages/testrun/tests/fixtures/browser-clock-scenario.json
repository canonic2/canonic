  {"action":{"kind":"install","timeMs":1700000000000}},
  {"action":{"kind":"set_fixed_time","timeMs":1700000000000}},
  {"action":{"kind":"pause_at","timeMs":1700000000000}},
  {"evaluate":"()=>{globalThis.acmeTicks=0;globalThis.acmeFrames=[];globalThis.acmeBaseline=performance.now();setInterval(()=>acmeTicks++,1000);requestAnimationFrame(t=>acmeFrames.push(t));return JSON.stringify([Date.now(),+new Date(),+new Date(0)]);}"},
