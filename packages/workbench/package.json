{
  "name": "workbench-development",
  "private": true,
  "version": "0.15.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/develop.cjs launch",
    "dev:prepare": "node scripts/develop.cjs prepare",
    "test:focus": "node scripts/develop.cjs test",
    "test": "node scripts/build-server.cjs --debug && node --test",
    "check": "tsc -p tsconfig.json",
    "serve": "node server/node/server.js",
    "package": "node scripts/package.cjs",
    "package:all": "node scripts/package-all.cjs",
    "bundle-runtime": "node scripts/bundle-runtime.cjs",
    "format:server": "make -C server format",
    "format:check:server": "make -C server format-check",
    "lint:server": "make -C server lint",
    "types:server": "make -C server types",
    "test:server": "make -C server test",
    "doctest:server": "make -C server doctest",
    "docs:server": "make -C server docs",
    "deps:server": "make -C server deps",
    "coverage:server": "make -C server coverage",
    "lint": "eslint ui/src --max-warnings=0",
    "format": "prettier --write ui/src eslint.config.mjs .prettierrc.json scripts/run-ui-tests.cjs scripts/ui-quality.test.cjs",
    "format:check": "prettier --check ui/src eslint.config.mjs .prettierrc.json scripts/run-ui-tests.cjs scripts/ui-quality.test.cjs",
    "typecheck": "pnpm run check",
    "test:ui": "node scripts/run-ui-tests.cjs",
    "check:ui": "pnpm run lint && pnpm run format:check && pnpm run test:ui"
  },
  "dependencies": {
    "@rspack/plugin-react-refresh": "2.0.2",
    "@vue/compiler-sfc": "3.5.43",
    "esbuild": "0.28.2",
    "ignore": "7.0.12",
    "lucide": "1.33.0",
    "picomatch": "4.0.7",
    "react-refresh": "0.19.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vscode/vsce": "3.9.2",
    "astro": "7.3.5",
    "eslint": "10.13.0",
    "eslint-plugin-wc": "3.1.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vue": "3.5.43"
  }
}
