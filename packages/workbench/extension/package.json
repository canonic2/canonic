{
  "name": "canonic-workbench",
  "displayName": "Canonic Workbench",
  "description": "Renders a project's pages and component previews on one canvas at device widths, with annotations and screenshots for coding agents.",
  "version": "0.15.0",
  "publisher": "canonic",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://canonic.sh/workbench/",
  "repository": {
    "type": "git",
    "url": "https://github.com/canonic2/canonic.git"
  },
  "bugs": {
    "url": "https://github.com/canonic2/canonic/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.123.0",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "design",
    "design system",
    "preview",
    "screenshot",
    "storybook",
    "implementation",
    "lens"
  ],
  "activationEvents": [
    "workspaceContains:workbench.yaml",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Workbench",
      "properties": {
        "workbench.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log request and page selection phase timings to Output → Workbench. Reload the window after changing this setting."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canonic",
          "title": "Workbench",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "canonic": [
        {
          "type": "webview",
          "id": "canonic.sidebar",
          "name": "Workbench",
          "when": "canonic.hasWorkbench"
        }
      ]
    },
    "commands": [
      {
        "command": "canonic.openWorkbench",
        "title": "Open Canvas",
        "category": "Workbench",
        "icon": "$(open-preview)"
      },
      {
        "command": "canonic.openWorkbenchExternally",
        "title": "Open Canvas in Browser",
        "category": "Workbench"
      },
      {
        "command": "canonic.copyWorkbenchUrl",
        "title": "Copy Canvas URL",
        "category": "Workbench"
      },
      {
        "command": "canonic.refreshPages",
        "title": "Refresh Pages",
        "category": "Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "canonic.showWorkbenchLog",
        "title": "Show Log",
        "category": "Workbench"
      },
      {
        "command": "canonic.addSpace",
        "title": "Add Space\u2026",
        "category": "Workbench"
      },
      {
        "command": "canonic.switchSpace",
        "title": "Switch Space\u2026",
        "category": "Workbench"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canonic.switchSpace",
          "when": "canonic.hasWorkbench"
        },
        {
          "command": "canonic.refreshPages",
          "when": "canonic.hasWorkbench"
        }
      ],
      "view/title": [
        {
          "command": "canonic.openWorkbench",
          "when": "view == canonic.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "canonic.refreshPages",
          "when": "view == canonic.sidebar",
          "group": "navigation@2"
        }
      ]
    }
  }
}
