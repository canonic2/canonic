schema_version: 1
kind: custom
capabilities:
- argument-rules-v1
- structured-rules-v1
rules:
- id: acme-applied
  decision: allow
  reason: Acme read
  conditions:
    arguments:
      kind: exact
      values:
      - read
    domain: argv
    executable: acme
- id: acme-pending
  decision: allow
  reason: Acme read
  conditions:
    arguments:
      kind: exact
      values:
      - read
    domain: argv
    executable: acme
