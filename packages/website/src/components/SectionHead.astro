---
/* A section's kicker, heading, and optional lede (the default slot). */
interface Props {
  kicker: string;
  title: string;
  lang?: string;
  contentLang?: string;
  kickerLang?: string;
}
const { kicker, title, kickerLang, lang = 'en', contentLang = 'en' } = Astro.props;
---
<div class="section-head" lang={lang}>
  <span class="kicker" lang={kickerLang}>{kicker}</span>
  <h2>{title}</h2>
  {Astro.slots.has('default') && <p class="lede" lang={contentLang}><slot /></p>}
</div>
