---
/* The top of an inner page: a kicker, the page's one <h1>, and a lede (the
   default slot). */
interface Props {
  kicker: string;
  title: string;
  lang?: string;
  contentLang?: string;
  /** The text column's width. */
  width?: 'narrow' | 'narrower';
}
const { kicker, title, width = 'narrow', lang = 'en', contentLang = 'en' } = Astro.props;
---
<section class="page-hero" lang={lang}>
  <div class:list={['wrap', width]}>
    <span class="kicker">{kicker}</span>
    <h1>{title}</h1>
    {Astro.slots.has('default') && <p class="lede" lang={contentLang}><slot /></p>}
  </div>
</section>
