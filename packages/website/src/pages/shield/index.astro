---
import { base } from '../../lib/base.js';
import { websiteLocale } from '../../lib/locales.js';
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Feature from '../../components/Feature.astro';
import TextWithCode from '../../components/TextWithCode.astro';
import { products } from '../../lib/marks.js';
import { download, github, pages, shieldNav } from '../../lib/shield.js';

const mark = products.find(product => product.name === 'Shield');
const quickStart = 'shield setup\nshield status\nshield doctor';
const packs = 'shield pack search node\nshield pack add node --profile strict\nshield pack update';
const install = 'git clone https://github.com/canonic2/canonic.git\ncd canonic/packages/shield\ncargo xtask install';
const { t, href } = websiteLocale(Astro.url, base);

---
<Base title="Canonic Shield" description={t('Project permissions for Claude Code and Codex, with reviewed rules, signed permission packs and request history.')}
  product="Shield" nav={shieldNav('Overview')} github={github} download={download}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <a class="chip" href={href(pages.docs)}>
          <svg viewBox={mark.viewBox} aria-hidden="true"><path d={mark.base} fill="currentColor" /><path d={mark.accent} class="accent" /></svg>
          Canonic Shield
        </a>
        <h1>{t("Project permissions for coding agents.")}</h1>
        <p>{t("Shield checks the commands, file reads and web requests that Claude Code and Codex submit against rules you keep with your project. Each request gets Allow, Ask or Deny, with the rules that decided it.")}</p>
        <div class="actions">
          <a class="btn" href={href(`${pages.docs}getting-started/`)}>{t("Get started")}</a>
          <a class="btn btn-ghost" href={href(pages.docs)}>{t("Read the guides")}</a>
        </div>
      </div>
      <CodeBlock file={t('In your project')} code={quickStart} copies="the Shield quick-start commands" />
    </div>
  </section>
  <section class="features band">
    <div class="wrap">
      <Feature id="permissions" kicker={t("Project policy")} title={t("Start with rules you can review.")}>
        <p><TextWithCode text={t('{command} installs a signed baseline pack and connects your agents. Pick a Loose, Recommended or Strict profile, then review and confirm the changes.')} code={{ command: 'shield setup' }} /></p>
        <p>{t('Add permission packs for the tools you use, or write precise YAML or JSON rules for commands, arguments, paths and web addresses. Agents can propose rules; changes need your confirmation.')}</p>
        <div class="feature-media" slot="media"><CodeBlock file={t('Permission packs')} code={packs} copies="the permission-pack commands" /></div>
      </Feature>
      <Feature id="install" kicker={t("Install")} title={t("Build one Rust CLI from source.")}>
        <p>{t('Shield has not been published to package managers yet. Install Rust, clone the repository and build the CLI. The checkout pins its toolchain.')}</p>
        <p><TextWithCode text={t('On macOS and Linux, the command installs {shield} into {directory}. Add that folder to your {path}. Windows source builds support project enrollment and hooks for Claude Code and Codex.')} code={{ shield: 'shield', directory: '~/.local/bin', path: 'PATH' }} /> <a href={href(`${pages.docs}development/#portable-windows-packages`)}>{t('Windows installation')}</a></p>
        <p>{t("Shield checks submitted requests. It does not replace the agent's sandbox, and a host that skips its hooks bypasses enforcement.")} <a href={href(`${pages.docs}introduction/`)}>{t('What is Shield?')}</a></p>
        <div class="feature-media" slot="media"><CodeBlock file={t('Terminal')} code={install} copies="the Shield source installation commands" /></div>
      </Feature>
    </div>
  </section>
</Base>
