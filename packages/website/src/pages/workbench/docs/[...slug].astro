---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';
import { base } from '../../../lib/base.js';
import { docTitle, docsHref, docsNavigation } from '../../../lib/docs.js';
import { download, downloads, github, workbenchNav } from '../../../lib/workbench.js';
import '../../../styles/docs.css';

export async function getStaticPaths() {
  const entries = await getCollection('workbenchDocs');
  return entries.map(entry => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id.replace(/\/index$/, '') },
    props: { entry, groups: docsNavigation(entries) },
  }));
}

const { entry, groups } = Astro.props;
const { Content, headings } = await render(entry);
const title = docTitle(entry);
const pages = groups.flatMap(group => group.entries);
const position = pages.findIndex(page => page.id === entry.id);
const previous = pages[position - 1];
const next = pages[position + 1];
const sections = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const group = groups.find(group => group.entries.some(page => page.id === entry.id));
const version = (await downloads())?.version;
const description = entry.body.split('\n\n').find(paragraph => !paragraph.startsWith('#'))?.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[`*\n]/g, ' ').slice(0, 180);
---
<Base title={`${title} · Workbench docs · Canonic`} description={description} product="Workbench"
  version={version} nav={workbenchNav('Docs')} github={github} download={download}>
  <div class="docs-shell wrap">
    <DocsSidebar groups={groups} current={entry.id} />
    <article class="docs-article">
      <div class="docs-breadcrumb"><a href={docsHref('index', base)}>Workbench docs</a><span aria-hidden="true">/</span><span>{group.title}</span></div>
      <div class="docs-prose"><Content /></div>
      <div class="docs-page-footer">
        <a target="_blank" rel="noopener" href={`${github}/blob/main/workbench/docs/${entry.id.replace(/(^|\/)index$/, '$1README')}.md`}>View Markdown on GitHub ↗</a>
      </div>
      <nav class="docs-pagination" aria-label="Guide navigation">
        {previous ? <a href={docsHref(previous.id, base)}><span>← Previous</span><strong>{docTitle(previous)}</strong></a> : <span />}
        {next && <a href={docsHref(next.id, base)}><span>Next →</span><strong>{docTitle(next)}</strong></a>}
      </nav>
    </article>
    {sections.length > 0 && <aside class="docs-toc" aria-label="On this page">
      <h2>On this page</h2>
      <nav>{sections.map(heading => <a href={`#${heading.slug}`} class:list={{ 'docs-toc-sub': heading.depth === 3 }}>{heading.text}</a>)}</nav>
      <a class="docs-back-top" href="#content">Back to top ↑</a>
    </aside>}
  </div>
</Base>
